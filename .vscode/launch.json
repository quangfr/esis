{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ESIS (Edge)",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5173/esis/",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "preLaunchTask": "Start Vite",
      "postDebugTask": "Stop Vite"
    },
    {
      "name": "Launch ESIS (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173/esis/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Vite",
      "postDebugTask": "Stop Vite"
    }
  ]
}
